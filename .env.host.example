# --- قاعدة البيانات: Supabase (Postgres) — لا SQLite ---
# استخدم Session pooler (IPv4). الاتصال المباشر db.<ref>.supabase.co قد يكون IPv6 فقط
# ولا يعمل على معظم خوادم الاستضافة. الصيغة:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
DB_SCHEMA=tdrive
DB_SSL=true
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=15000
CONTENT_BACKEND=telegram
TG_BOT_TOKEN=Ø¶Ø¹-ØªÙˆÙƒÙ†-Ø§Ù„Ø¨ÙˆØª
TG_CHAT_ID=-100xxxxxxxxxx
TG_MIN_GAP_MS=3000
# Ø³Ù‚Ù ÙƒØ§Ø´ Ø§Ù„Ù‚Ø·Ø¹ Ø¹Ù„Ù‰ Ø§Ù„Ù‚Ø±Øµ (Ø§Ù„Ù‚Ø±Øµ 15GB) â€” Ø£Ø¨Ù‚ÙÙ‡ ØµØºÙŠØ±Ù‹Ø§
CACHE_CAP_GB=3

# --- Ø­Ø¯ÙˆØ¯ Ù…Ù†Ø§Ø³Ø¨Ø© Ù„Ù‚Ø±Øµ 15GB (Ø§Ù„Ù…Ù„Ù ÙŠÙÙ†Ø²ÙŽÙ‘Ù„ ÙƒØ§Ù…Ù„Ù‹Ø§ Ù…Ø¤Ù‚Ù‘ØªÙ‹Ø§ Ù‚Ø¨Ù„ Ø§Ù„ØªÙ‚Ø·ÙŠØ¹) ---
