# ===== Tdrive على HidenCloud (Node مغلقة / Pterodactyl، arm64) =====
# انسخ هذا إلى .env داخل مجلّد الخادم عبر مدير الملفّات، واملأ القيم الحقيقية.

NODE_ENV=production
HOST=0.0.0.0
# المنفذ المخصّص في اللوحة. اتركه فارغًا ليُؤخذ تلقائيًّا من SERVER_PORT.
PORT=24600
PUBLIC_URL=https://tdrive.cc.cd
LOG_LEVEL=info

# --- المالك ---
OWNER_USERNAME=owner
OWNER_PASSWORD=ضع-كلمة-مرور-قويّة
# ولّده بـ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ضع-سرًّا-عشوائيًّا-طويلًا
SESSION_TTL_DAYS=30

# --- التخزين: Telegram دائم + القرص كاش ---
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/storage
TMP_DIR=./data/tmp
DB_PATH=./data/tdrive.sqlite
CONTENT_BACKEND=telegram
TG_BOT_TOKEN=ضع-توكن-البوت
TG_CHAT_ID=-100xxxxxxxxxx
TG_MIN_GAP_MS=3000
# سقف كاش القطع على القرص (القرص 15GB) — أبقِه صغيرًا
CACHE_CAP_GB=3

# --- حدود مناسبة لقرص 15GB (الملف يُنزَّل كاملًا مؤقّتًا قبل التقطيع) ---
CHUNK_SIZE_MB=18
# حدّ أقصى لحجم الملف الواحد ليبقى ضمن القرص المؤقّت
MAX_FILE_SIZE_GB=8
MAX_PART_BODY_MB=20
# تحميل واحد في المرة (محدودية القرص المؤقّت)
DOWNLOAD_CONCURRENCY=1
JOB_MAX_ATTEMPTS=5

# --- الأدوات: تُهيّأ تلقائيًّا في ./bin عبر scripts/launch.mjs (لا تعدّلها عادةً) ---
# YTDLP_PATH=./bin/yt-dlp
# FFMPEG_PATH=./bin/ffmpeg
# FFPROBE_PATH=./bin/ffprobe
THUMBNAILS_ENABLED=true
# يوتيوب على الخوادم كثيرًا ما يطلب "تأكيد أنك لست روبوتًا". وفّر ملف كوكيز لتجاوزه:
#   صدّر cookies.txt من متصفّحك (إضافة "Get cookies.txt") وارفعه، ثم:
# YTDLP_COOKIES=/home/container/cookies.txt
# وسائط yt-dlp إضافية عند الحاجة (مثل اختيار عميل المشغّل):
# YTDLP_EXTRA_ARGS=

# --- نسخ احتياطي MySQL (قاعدة من اللوحة أو خارجية) — اختياريّ ---
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=18
MYSQL_BACKUP_URL=
BACKUP_RETENTION=7
BACKUP_PREFIX=_system/backups

RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
CORS_ORIGINS=
