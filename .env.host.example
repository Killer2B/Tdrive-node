# --- Ø§Ù„ØªØ®Ø²ÙŠÙ†: Telegram Ø¯Ø§Ø¦Ù… + Ø§Ù„Ù‚Ø±Øµ ÙƒØ§Ø´ ---
STORAGE_DRIVER=local
