# deps / build
node_modules/
/dist/
web/node_modules/
# ملاحظة: web/dist متتبَّع عمدًا — بيئة الاستضافة المغلقة تحظر بناء Vite (esbuild)،
# فنوزّع الواجهة مبنيّة مسبقًا ليقدّمها الخادم مباشرةً.

# lockfiles تُولَّد لكل بيئة؛ إبقاؤها خارج Git يمنع تعارض git pull التلقائيّ (AUTO_UPDATE)
package-lock.json
web/package-lock.json

# runtime data (storage + sqlite)
data/
*.sqlite
*.sqlite-*
*.db
*.db-*

# env & secrets
.env
.env.local
.env.*.local

# logs / tmp
*.log
tmp/
.tmp/
.DS_Store

# tool binaries fetched at runtime
bin/yt-dlp
bin/yt-dlp.exe
bin/ffmpeg
bin/ffmpeg.exe
bin/ffprobe
bin/ffprobe.exe
bin/*.part
