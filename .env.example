# ===== Tdrive configuration (انسخه إلى .env واملأ القيم) =====

# --- أساسي ---
NODE_ENV=production
HOST=0.0.0.0
PORT=24600
# العنوان العام الكامل للتطبيق (يُستخدم للكوكيز/الروابط). مطلوب في الإنتاج خلف Proxy.
PUBLIC_URL=https://tdrive.cc.cd
LOG_LEVEL=info

# --- المالك (المصادقة) ---
# يُنشأ المالك تلقائيًّا عند أول تشغيل من هذه القيم إن لم يوجد مستخدم بعد.
# بعد أول تشغيل غيّر كلمة المرور من الإعدادات واحذف OWNER_PASSWORD من البيئة.
OWNER_USERNAME=owner
OWNER_PASSWORD=change-this-now-9x!Qz
# سرّ توقيع الكوكيز/الجلسات (32+ محرف عشوائي). ولّده بـ: openssl rand -hex 32
SESSION_SECRET=please-generate-a-long-random-secret-min-32-chars
# مدّة الجلسة بالأيام
SESSION_TTL_DAYS=30

# --- التخزين ---
# driver: local | s3
STORAGE_DRIVER=local
# المسار الجذر للتخزين المحلّي
LOCAL_STORAGE_DIR=./data/storage
# مجلد البيانات المؤقّتة (أجزاء الرفع/التحميلات الجارية)
TMP_DIR=./data/tmp
# مسار قاعدة بيانات SQLite
DB_PATH=./data/tdrive.sqlite

# --- التخزين المتوافق مع S3 (عند STORAGE_DRIVER=s3) ---
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=tdrive
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# نمط الوصول: path (MinIO/R2) أو virtual-host
S3_FORCE_PATH_STYLE=true

# --- التخزين الدائم للمحتوى ---
# telegram = التخزين الأساسي والنهائي (القرص مجرّد كاش) | local = القرص دائم
CONTENT_BACKEND=telegram
# توكن البوت من @BotFather (ضع القيمة الحقيقية في .env فقط)
TG_BOT_TOKEN=
# معرّف المجموعة/السوبرجروب (مثال: -1001234567890) — البوت يجب أن يكون مشرفًا
TG_CHAT_ID=
# أدنى فجوة (ms) بين عمليات الرفع إلى Telegram (حارس flood-wait)
TG_MIN_GAP_MS=3000
TG_API_BASE=https://api.telegram.org
# سقف كاش القطع على القرص (GB) — يُخلى تلقائيًّا للقطع المؤكّدة على Telegram
CACHE_CAP_GB=4

# --- حدود الرفع ---
# حجم الجزء الافتراضي (MB). القيمة المطلوبة: 18
CHUNK_SIZE_MB=18
# حدّ أقصى اختياري لحجم الملف الواحد (GB). 0 = غير محدود (يُحدّه التخزين فقط)
MAX_FILE_SIZE_GB=0
# أقصى حجم جسم لطلب رفع جزء واحد (MB) — يجب أن يفوق CHUNK_SIZE_MB بهامش
MAX_PART_BODY_MB=20

# --- طابور التحميل ---
# عدد التحميلات المتزامنة
DOWNLOAD_CONCURRENCY=2
# أقصى عدد محاولات لكل مهمة
JOB_MAX_ATTEMPTS=5
# مهلة اتصال التحميل المباشر (ms)
HTTP_CONNECT_TIMEOUT_MS=15000
# مهلة الخمول أثناء البثّ (ms) قبل اعتبار الاتصال ميتًا
HTTP_IDLE_TIMEOUT_MS=60000

# --- أدوات خارجية ---
# مسار yt-dlp (اتركه yt-dlp إن كان في PATH)
YTDLP_PATH=yt-dlp
# مسار ffmpeg/ffprobe (اتركها كما هي إن كانت في PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# تمكين توليد الصور المصغّرة للفيديو (يتطلّب ffmpeg)
THUMBNAILS_ENABLED=true

# --- النسخ الاحتياطي لقاعدة بيانات MySQL الخارجية ---
# فعّل النسخ الدوري كل BACKUP_INTERVAL_HOURS
BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=18
# سلسلة اتصال MySQL (mysql://user:pass@host:port/db). رمِّز كلمة المرور URL-encoding.
# الصيغة: mysql://USER:URL_ENCODED_PASSWORD@HOST:3306/DBNAME
# ضع القيمة الحقيقية في ملف .env فقط (غير متتبَّع في Git) — لا تضعها هنا.
MYSQL_BACKUP_URL=
# كم نسخة احتياطية تُحتفظ بها (الأقدم يُحذف)
BACKUP_RETENTION=14
# بادئة مفتاح التخزين لحفظ النسخ داخل نظام التخزين الداخلي
BACKUP_PREFIX=_system/backups

# --- الأمان / التقنين ---
# أقصى عدد طلبات لكل IP في النافذة
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
# السماح بالأصول في CORS (افصل بفواصل). افتراضيًّا نفس الأصل فقط.
CORS_ORIGINS=
