{
  "name": "tdrive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tdrive — سحابة شخصية خاصة: تحميل من يوتيوب/الروابط، رفع مجزّأ قابل للاستئناف، بثّ، وإدارة ملفات.",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "backup:now": "tsx src/scripts/backup-cli.ts",
    "owner:set": "tsx src/scripts/owner-cli.ts",
    "ytdlp:update": "node scripts/update-ytdlp.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^8.0.3",
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0",
    "mysql2": "^3.11.5",
    "pino": "^9.5.0",
    "undici": "^6.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
